{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-chat-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  // "open" = public demo (no passcode). Use "passcode" to require TEAM_PASSCODE.
  "vars": { "ACCESS_MODE": "open" },
  "vectorize": [
    { "binding": "MEMORY_INDEX", "index_name": "team-memory", "remote": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker so it can redirect to HTTPS and add security headers.
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "class_name": "TeamRoom", "name": "TeamRoom" },
      { "class_name": "TeamMember", "name": "TeamMember" },
      { "class_name": "LoginGuard", "name": "LoginGuard" }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["TeamRoom", "TeamMember"],
      "tag": "v1"
    },
    {
      "new_sqlite_classes": ["LoginGuard"],
      "tag": "v2"
    }
  ]
}
